# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 포함되어 있어 커밋되지 않습니다. 실제 키를 이 예시 파일에 쓰지 마세요.

# 사용할 LLM: openai 또는 gemini
LLM_PROVIDER=openai

# OpenAI (LLM_PROVIDER=openai 일 때 필요)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (LLM_PROVIDER=gemini 일 때 필요)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kakao Local - 카카오 개발자 콘솔의 "REST API 키"
KAKAO_REST_API_KEY=

# (선택) API 요청 타임아웃(초)
HTTP_TIMEOUT=30
