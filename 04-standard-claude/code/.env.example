# 이 파일을 .env 로 복사한 뒤 실제 키를 넣으세요.  (cp .env.example .env)
# .env 는 .gitignore 에 들어 있어 커밋되지 않습니다. 이 파일(.env.example)에는 실제 키를 넣지 마세요.

OPENAI_API_KEY=
KAKAO_REST_API_KEY=

# 선택 (비워 두면 기본값 사용)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# KAKAO_BASE_URL=https://dapi.kakao.com
